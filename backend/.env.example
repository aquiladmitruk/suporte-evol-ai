# =============================================================================
# Assistente de IA para Suporte do ERP Evol — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env com valores reais no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# VARIÁVEIS OBRIGATÓRIAS
# O serviço NÃO iniciará se alguma destas estiver ausente.
# -----------------------------------------------------------------------------

# URL do cluster Qdrant (local ou cloud)
# Formato cloud: https://<cluster-id>.<region>.gcp.cloud.qdrant.io
QDRANT_URL=https://seu-cluster.qdrant.io

# Chave de API do provedor LLM (OpenAI ou compatível)
LLM_API_KEY=sk-...

# Identificador do modelo LLM a ser utilizado (ex.: gpt-4o, gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Identificador do modelo de embeddings (ex.: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# Origens permitidas para CORS, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# VARIÁVEIS OPCIONAIS (possuem valores padrão)
# -----------------------------------------------------------------------------

# Chave de API do Qdrant Cloud (obrigatória para a versão cloud)
# QDRANT_API_KEY=

# Nome da coleção no Qdrant onde os documentos serão indexados
# Padrão: evol_docs
# QDRANT_COLLECTION=evol_docs

# Número máximo de chunks recuperados por busca semântica (RAG top-K)
# Padrão: 5
# RAG_TOP_K=5

# Limiar mínimo de similaridade semântica (0.0 a 1.0)
# Padrão: 0.7
# RAG_SIMILARITY_THRESHOLD=0.7

# Tempo de vida (TTL) das sessões em memória, em segundos
# Padrão: 3600 (1 hora)
# SESSION_TTL_SECONDS=3600

# Tamanho máximo de cada chunk em tokens
# Padrão: 512
# CHUNK_SIZE=512

# Sobreposição entre chunks consecutivos em tokens
# Padrão: 64
# CHUNK_OVERLAP=64
